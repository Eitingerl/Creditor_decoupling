yaml_content <- '
name: Test Relative Paths & Execute Master Script
on:
push:
branches: [ main, master ]
workflow_dispatch:
jobs:
execute-script:
runs-on: ubuntu-latest
steps:
- name: Checkout code
uses: actions/checkout@v4
- name: Setup R Environment
uses: r-lib/actions/setup-r@v2
with:
r-version: "release"
- name: Install System Dependencies
run: |
sudo apt-get update
sudo apt-get install -y libcurl4-openssl-dev libxml2-dev libssl-dev libfontconfig1-dev libharfbuzz-dev libfribidi-dev libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev
- name: Install Required R Packages
run: |
options(repos = c(CRAN = "https://packagemanager.posit.co/cran/__linux__/jammy/latest"))
pkgs <- c(
"tidyverse", "haven", "sjPlot", "plm", "lme4", "car", "readxl",
"writexl", "fixest", "forecast", "tseries", "sandwich", "lmtest",
"AER", "stargazer", "naniar", "nortest", "slider", "countrycode",
"psych", "psychTools", "xtable", "modelsummary", "ivDiag",
"factoextra", "NbClust", "compositions", "strucchange",
"mediation", "multilevel", "bda"
)
install.packages(pkgs)
shell: Rscript {0}
- name: Run Master Script
run: Rscript master_execute_main.R
'
writeLines(yaml_content, ".github/workflows/run_analysis.yml")
