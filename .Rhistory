# List the actual years it was used for your visual confirmation
years_active = paste(sort(unique(year)), collapse = ", "),
# Count how many total projects used this instrument
project_count = n(),
.groups = "drop"
) %>%
# Filter down to only the instruments that pass the test
filter(only_20_21 == TRUE)
